<UserControl x:Class="GamepadApp.Views.KeyBindingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0E0E0E">

    <UserControl.Resources>

        <!-- ANA PANEL -->
        <Style x:Key="SectionBorderStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="#151515"/>
            <Setter Property="BorderBrush"
                    Value="#303030"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="CornerRadius"
                    Value="4"/>
            <Setter Property="Padding"
                    Value="10"/>
        </Style>

        <!-- BÖLÜM BAŞLIKLARI -->
        <Style x:Key="SectionTitleStyle"
               TargetType="TextBlock">
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="FontSize"
                    Value="14"/>
            <Setter Property="FontWeight"
                    Value="SemiBold"/>
            <Setter Property="Margin"
                    Value="0,0,0,6"/>
        </Style>

        <!-- ALT BUTONLAR -->
        <Style x:Key="BottomButtonStyle"
               TargetType="Button">
            <Setter Property="Height"
                    Value="34"/>
            <Setter Property="MinWidth"
                    Value="115"/>
            <Setter Property="Margin"
                    Value="8,0,0,0"/>
            <Setter Property="Background"
                    Value="#252525"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderBrush"
                    Value="#3A3A3A"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <!-- TUŞ ATAMA BUTONLARI -->
        <Style x:Key="MappingButtonStyle"
       TargetType="Button">

            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#202020"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>

        </Style>

        <!-- TUŞ İSMİ -->
        <Style x:Key="MappingLabelStyle"
       TargetType="TextBlock">

            <Setter Property="Foreground" Value="#BDBDBD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>

        </Style>

    </UserControl.Resources>


    <Grid>

        <Grid.RowDefinitions>

            <!-- TÜM ANA İÇERİK -->
            <RowDefinition Height="*"/>

            <!-- ALT SABİT BAR -->
            <RowDefinition Height="52"/>

        </Grid.RowDefinitions>


        <!-- ====================================================== -->
        <!-- ANA İÇERİK -->
        <!-- ====================================================== -->

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid x:Name="BindingsContent"
                  MaxWidth="1450"
                  Margin="14"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">

            <Grid.RowDefinitions>

                <!-- ÜST BÖLÜM -->
                <RowDefinition Height="88"/>

                <RowDefinition Height="12"/>

                <!-- ANA TUŞ ATAMA BÖLÜMÜ -->
                <RowDefinition Height="460"/>

                <RowDefinition Height="12"/>

                <!-- ALT AYAR BÖLÜMÜ -->
                <RowDefinition Height="190"/>

            </Grid.RowDefinitions>


            <!-- ================================================= -->
            <!-- ÜST CİHAZ / PROFİL ALANI -->
            <!-- ================================================= -->

            <Border Grid.Row="0"
                    Style="{StaticResource SectionBorderStyle}">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.6*"/>
                    </Grid.ColumnDefinitions>


                    <!-- GAMEPAD -->
                    <StackPanel Grid.Column="0">

                        <TextBlock x:Name="GamepadSectionTitle"
                                   Text="Gamepad"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <ComboBox x:Name="GamepadComboBox"
                                  Height="32">

                            <ComboBoxItem Content="DualShock 4"
                  Tag="DS4"
                  IsSelected="True"/>

                            <ComboBoxItem Content="Xbox 360"
                  Tag="Xbox360"/>

                        </ComboBox>

                    </StackPanel>


                    <!-- CİHAZ -->
                    <StackPanel Grid.Column="2">

                        <TextBlock x:Name="DeviceSectionTitle"
                                   Text="Cihaz"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <ComboBox x:Name="DeviceComboBox"
                                  Height="32">
                        </ComboBox>

                    </StackPanel>


                    <!-- ANA UYGULAMA PROFİLİ -->
                    <StackPanel Grid.Column="4">

                        <TextBlock x:Name="ActiveProfileSectionTitle"
                                   Text="Aktif Profil"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Border Height="32"
                                Padding="10,0"
                                Background="#181818"
                                BorderBrush="#3A3A3A"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBlock x:Name="ActiveProfileNameText"
                                       Text="-"
                                       Foreground="#E6E6E6"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>

                    </StackPanel>

                </Grid>

            </Border>


            <!-- ================================================= -->
            <!-- ANA TUŞ ATAMA ALANI -->
            <!-- ================================================= -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>

                    <!-- SOL -->
                    <ColumnDefinition Width="1*"/>

                    <ColumnDefinition Width="12"/>

                    <!-- ORTA -->
                    <ColumnDefinition Width="1.10*"/>

                    <ColumnDefinition Width="12"/>

                    <!-- SAĞ -->
                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>


                <!-- ================= SOL ================= -->

                <Grid Grid.Column="0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="220"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="220"/>
                    </Grid.RowDefinitions>

                    <!-- D-PAD -->
                    <Border Grid.Row="0"
        Style="{StaticResource SectionBorderStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="DpadSectionTitle"
                                       Grid.Row="0"
                                       Text="D-Pad"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Grid.Row="1"
              Margin="10,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>


                                <!-- YUKARI -->
                                <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="DpadUpLabel"
                                               Text="Yukarı"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="DpadUpBindingBtn"
        Content="D-Pad Up"
        Style="{StaticResource MappingButtonStyle}"
        Click="DpadUpBindingBtn_Click"/>

                                </StackPanel>


                                <!-- SOL -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="DpadLeftLabel"
                                               Text="Sol"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="DpadLeftBindingBtn"
        Content="D-Pad Left"
        Style="{StaticResource MappingButtonStyle}"
        Click="DpadLeftBindingBtn_Click"/>

                                </StackPanel>


                                <!-- SAĞ -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="DpadRightLabel"
                                               Text="Sağ"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="DpadRightBindingBtn"
        Content="D-Pad Right"
        Style="{StaticResource MappingButtonStyle}"
        Click="DpadRightBindingBtn_Click"/>

                                </StackPanel>


                                <!-- AŞAĞI -->
                                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="DpadDownLabel"
                                               Text="Aşağı"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="DpadDownBindingBtn"
        Content="D-Pad Down"
        Style="{StaticResource MappingButtonStyle}"
        Click="DpadDownBindingBtn_Click"/>

                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- SOL ANALOG -->
                    <Border Grid.Row="2"
        Style="{StaticResource SectionBorderStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="LeftStickSectionTitle"
                                       Grid.Row="0"
                                       Text="Sol Analog"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Grid.Row="1"
              Margin="10,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- YUKARI -->
                                <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="LeftStickUpLabel"
                                               Text="Yukarı"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="LeftStickUpBindingBtn"
                        Content="LS Y+"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="LeftStickUpBindingBtn_Click"/>

                                </StackPanel>

                                <!-- SOL -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="LeftStickLeftLabel"
                                               Text="Sol"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="LeftStickLeftBindingBtn"
                        Content="LS X-"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="LeftStickLeftBindingBtn_Click"/>

                                </StackPanel>

                                <!-- SAĞ -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="LeftStickRightLabel"
                                               Text="Sağ"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="LeftStickRightBindingBtn"
                        Content="LS X+"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="LeftStickRightBindingBtn_Click"/>

                                </StackPanel>

                                <!-- AŞAĞI -->
                                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="LeftStickDownLabel"
                                               Text="Aşağı"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="LeftStickDownBindingBtn"
                        Content="LS Y-"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="LeftStickDownBindingBtn_Click"/>

                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>


                <!-- ================= ORTA ================= -->

                <Border Grid.Column="2"
                        Style="{StaticResource SectionBorderStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <TextBlock x:Name="CenterSectionTitle"
                                   Grid.Row="0"
                                   Text="Gamepad"
                                   Style="{StaticResource SectionTitleStyle}"
                                   HorizontalAlignment="Center"/>


                        <Grid Grid.Row="1">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="95"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>


                            <!-- ================= ÜST ATAMALAR ================= -->
                            <Grid Grid.Row="0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>


                                <!-- SOL OMUZ -->
                                <StackPanel Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="18,0,0,0">

                                    <TextBlock x:Name="L2SourceLabel"
                                               Text="L2"
               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="L2BindingBtn"
            Content="L2"
            Style="{StaticResource MappingButtonStyle}"
            Width="42"
            Height="24"
            MinWidth="0"
            HorizontalAlignment="Center"
            Margin="0,0,0,6"
            Click="L2BindingBtn_Click"/>

                                    <TextBlock x:Name="L1SourceLabel"
                                               Text="L1"
               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="L1BindingBtn"
            Content="L1"
            Style="{StaticResource MappingButtonStyle}"
            Width="42"
            Height="24"
            MinWidth="0"
            HorizontalAlignment="Center"
            Click="L1BindingBtn_Click"/>

                                </StackPanel>


                                <!-- SHARE -->
                                <StackPanel Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,3">

                                    <TextBlock x:Name="ShareSourceLabel"
                                               Text="Share"
               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="ShareBindingBtn"
            Content="Share"
            Style="{StaticResource MappingButtonStyle}"
            Padding="7,2"
            MinWidth="0"
            HorizontalAlignment="Center"
            Click="ShareBindingBtn_Click"/>

                                </StackPanel>


                                <StackPanel Grid.Column="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,3">

                                    <TextBlock x:Name="OptionsSourceLabel"
                                               Text="Options"
               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="OptionsBindingBtn"
            Content="Options"
            Style="{StaticResource MappingButtonStyle}"
            Padding="7,2"
            MinWidth="0"
            HorizontalAlignment="Center"
            Click="OptionsBindingBtn_Click"/>

                                </StackPanel>


                                <!-- SAĞ OMUZ -->
                                <StackPanel Grid.Column="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="0,0,18,0">

                                    <TextBlock x:Name="R2SourceLabel"
                                               Text="R2"
               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="R2BindingBtn"
            Content="R2"
            Style="{StaticResource MappingButtonStyle}"
            Width="42"
            Height="24"
            MinWidth="0"
            HorizontalAlignment="Center"
            Margin="0,0,0,6"
            Click="R2BindingBtn_Click"/>

                                    <TextBlock x:Name="R1SourceLabel"
                                               Text="R1"
               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="R1BindingBtn"
            Content="R1"
            Style="{StaticResource MappingButtonStyle}"
            Width="42"
            Height="24"
            MinWidth="0"
            HorizontalAlignment="Center"
            Click="R1BindingBtn_Click"/>

                                </StackPanel>

                            </Grid>


                            <!-- ================= GAMEPAD + L3/R3 ================= -->
                            <Grid Grid.Row="1">

                                <Image x:Name="BindingsLayoutImage"
               Source="pack://application:,,,/assets/controller_bindings_layout.png"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Margin="5,0,5,24"/>


                                <Grid VerticalAlignment="Bottom"
      Margin="0,0,0,22">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- L3 -->
                                    <StackPanel Grid.Column="0"
                HorizontalAlignment="Right"
                Margin="0,0,40,0">

                                        <TextBlock x:Name="L3SourceLabel"
                                                   Text="L3"
                   Style="{StaticResource MappingLabelStyle}"/>

                                        <Button x:Name="L3BindingBtn"
                Content="L3"
                Style="{StaticResource MappingButtonStyle}"
                Padding="7,2"
                MinWidth="0"
                HorizontalAlignment="Center"
                Click="L3BindingBtn_Click"/>

                                    </StackPanel>

                                    <!-- R3 -->
                                    <StackPanel Grid.Column="1"
                HorizontalAlignment="Left"
                Margin="40,0,0,0">

                                        <TextBlock x:Name="R3SourceLabel"
                                                   Text="R3"
                   Style="{StaticResource MappingLabelStyle}"/>

                                        <Button x:Name="R3BindingBtn"
                Content="R3"
                Style="{StaticResource MappingButtonStyle}"
                Padding="7,2"
                MinWidth="0"
                HorizontalAlignment="Center"
                Click="R3BindingBtn_Click"/>

                                    </StackPanel>

                                </Grid>

                            </Grid>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ================= SAĞ ================= -->

                <Grid Grid.Column="4">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="225"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="225"/>
                    </Grid.RowDefinitions>



                    <!-- YÜZ TUŞLARI -->
                    <Border Grid.Row="0"
        Style="{StaticResource SectionBorderStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="FaceButtonsSectionTitle"
                                       Grid.Row="0"
                                       Text="Yüz Tuşları"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Grid.Row="1"
              Margin="10,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>


                                <!-- TRIANGLE -->
                                <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="TriangleSourceLabel"
                                               Text="Triangle"
                           Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="TriangleBindingBtn"
        Content="Triangle"
        Style="{StaticResource MappingButtonStyle}"
        Click="TriangleBindingBtn_Click"/>

                                </StackPanel>


                                <!-- SQUARE -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="SquareSourceLabel"
                                               Text="Square"
                           Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="SquareBindingBtn"
        Content="Square"
        Style="{StaticResource MappingButtonStyle}"
        Click="SquareBindingBtn_Click"/>

                                </StackPanel>


                                <!-- CIRCLE -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="CircleSourceLabel"
                                               Text="Circle"
                           Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="CircleBindingBtn"
        Content="Circle"
        Style="{StaticResource MappingButtonStyle}"
        Click="CircleBindingBtn_Click"/>

                                </StackPanel>


                                <!-- CROSS -->
                                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="CrossSourceLabel"
                                               Text="Cross"
                           Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="CrossBindingBtn"
                                            Content="Cross"
                                            Style="{StaticResource MappingButtonStyle}"
                                            Click="CrossBindingBtn_Click"/>

                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>


                    <!-- SAĞ ANALOG -->
                    <Border Grid.Row="2"
        Style="{StaticResource SectionBorderStyle}">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="RightStickSectionTitle"
                                       Grid.Row="0"
                                       Text="Sağ Analog"
                                       Style="{StaticResource SectionTitleStyle}"/>

                            <Grid Grid.Row="1"
              Margin="10,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                    <RowDefinition Height="1*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- YUKARI -->
                                <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="RightStickUpLabel"
                                               Text="Yukarı"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="RightStickUpBindingBtn"
                        Content="RS Y+"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="RightStickUpBindingBtn_Click"/>

                                </StackPanel>

                                <!-- SOL -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="0"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="RightStickLeftLabel"
                                               Text="Sol"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="RightStickLeftBindingBtn"
                        Content="RS X-"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="RightStickLeftBindingBtn_Click"/>

                                </StackPanel>

                                <!-- SAĞ -->
                                <StackPanel Grid.Row="1"
                        Grid.Column="2"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="RightStickRightLabel"
                                               Text="Sağ"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="RightStickRightBindingBtn"
                        Content="RS X+"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="RightStickRightBindingBtn_Click"/>

                                </StackPanel>

                                <!-- AŞAĞI -->
                                <StackPanel Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Center">

                                    <TextBlock x:Name="RightStickDownLabel"
                                               Text="Aşağı"
                                               Style="{StaticResource MappingLabelStyle}"/>

                                    <Button x:Name="RightStickDownBindingBtn"
                        Content="RS Y-"
                        Style="{StaticResource MappingButtonStyle}"
                        Click="RightStickDownBindingBtn_Click"/>

                                </StackPanel>

                            </Grid>

                        </Grid>

                    </Border>

                </Grid>

            </Grid>

            <!-- ================================================= -->
            <!-- ALT AYAR ALANI -->
            <!-- ================================================= -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="1*"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="1.10*"/>

                    <ColumnDefinition Width="12"/>

                    <ColumnDefinition Width="1*"/>

                </Grid.ColumnDefinitions>


                <!-- SOL ALT -->
                <Border Grid.Column="0"
        Style="{StaticResource SectionBorderStyle}">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="VibrationSectionTitle"
                                   Grid.Row="0"
                                   Text="Titreşim ve Tetikler"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Button Grid.Row="1"
                                x:Name="VibrationTestBtn"
                                Content="Titreşimi Test Et"
                                Style="{StaticResource MappingButtonStyle}"
                                HorizontalAlignment="Left"
                                MinWidth="140"
                                Click="VibrationTestBtn_Click"/>

                        <Grid Grid.Row="3">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- SOL MOTOR -->
                            <StackPanel Grid.Column="0">

                                <TextBlock x:Name="LeftMotorLabel"
                                           Text="Sol Motor"
                                           Foreground="#BDBDBD"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>

                                <Slider x:Name="LeftMotorSlider"
        Minimum="0"
        Maximum="100"
        Value="100"
        ValueChanged="LeftMotorSlider_ValueChanged"/>

                                <TextBlock x:Name="LeftMotorValueText"
           Text="100%"
           Foreground="#777777"
           FontSize="11"
           HorizontalAlignment="Center"/>

                            </StackPanel>

                            <!-- SAĞ MOTOR -->
                            <StackPanel Grid.Column="2">

                                <TextBlock x:Name="RightMotorLabel"
                                           Text="Sağ Motor"
                                           Foreground="#BDBDBD"
                                           FontSize="12"
                                           Margin="0,0,0,4"/>

                                <Slider x:Name="RightMotorSlider"
            Minimum="0"
            Maximum="100"
            Value="100"
            ValueChanged="RightMotorSlider_ValueChanged"/>

                                <TextBlock x:Name="RightMotorValueText"
               Text="100%"
               Foreground="#777777"
               FontSize="11"
               HorizontalAlignment="Center"/>

                            </StackPanel>

                        </Grid>

                    </Grid>

                </Border>


                <!-- ORTA ALT -->
                <Border Grid.Column="2"
        Style="{StaticResource SectionBorderStyle}">

                    <StackPanel>

                        <TextBlock x:Name="GamepadInfoSectionTitle"
                                   Text="Gamepad Bilgileri"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <Grid Margin="0,8,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                                <RowDefinition Height="26"/>
                            </Grid.RowDefinitions>

                            <!-- DURUM -->
                            <TextBlock x:Name="StatusLabelText"
                                       Grid.Row="0"
                                       Text="Durum:"
                                       Foreground="#888888"/>

                            <TextBlock Grid.Row="0"
                       Grid.Column="1"
                       x:Name="GamepadStatusText"
                       Text="Bağlı değil"
                       Foreground="#D0D0D0"/>

                            <!-- CİHAZ -->
                            <TextBlock x:Name="DeviceLabelText"
                                       Grid.Row="1"
                                       Text="Cihaz:"
                                       Foreground="#888888"/>

                            <TextBlock Grid.Row="1"
                       Grid.Column="1"
                       x:Name="GamepadDeviceText"
                       Text="-"
                       Foreground="#D0D0D0"/>

                            <!-- BAĞLANTI -->
                            <TextBlock x:Name="ConnectionLabelText"
                                       Grid.Row="2"
                                       Text="Bağlantı:"
                                       Foreground="#888888"/>

                            <TextBlock Grid.Row="2"
                       Grid.Column="1"
                       x:Name="GamepadConnectionText"
                       Text="-"
                       Foreground="#D0D0D0"/>

                            <!-- PİL -->
                            <TextBlock x:Name="BatteryLabelText"
                                       Grid.Row="3"
                                       Text="Pil:"
                                       Foreground="#888888"/>

                            <TextBlock Grid.Row="3"
                       Grid.Column="1"
                       x:Name="GamepadBatteryText"
                       Text="%70"
                       Foreground="#D0D0D0"/>

                            <!-- PROFİL -->
                            <TextBlock x:Name="ProfileLabelText"
                                       Grid.Row="4"
                                       Text="Profil:"
                                       Foreground="#888888"/>

                            <TextBlock Grid.Row="4"
                       Grid.Column="1"
                       x:Name="GamepadProfileText"
                       Text="-"
                       Foreground="#D0D0D0"/>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- SAĞ ALT -->
                <Border Grid.Column="4"
        Style="{StaticResource SectionBorderStyle}">

                    <StackPanel>

                        <TextBlock x:Name="AnalogSettingsSectionTitle"
                                   Text="Analog Ayarları"
                                   Style="{StaticResource SectionTitleStyle}"/>

                        <!-- DEADZONE -->
                        <Grid Margin="0,6,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="DeadzoneLabel"
                                       Text="Deadzone"
                                       Foreground="#BDBDBD"
                                       VerticalAlignment="Center"/>

                            <Slider Grid.Column="1"
                    x:Name="DeadzoneSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="10"
                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                       x:Name="DeadzoneValueText"
                        Text="%10"
                       Foreground="#888888"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

                        </Grid>


                        <!-- ANTI-DEADZONE -->
                        <Grid Margin="0,6,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="AntiDeadzoneLabel"
                                       Text="Anti-Deadzone"
                                       Foreground="#BDBDBD"
                                       VerticalAlignment="Center"/>

                            <Slider Grid.Column="1"
                    x:Name="AntiDeadzoneSlider"
                    Minimum="0"
                    Maximum="100"
                    Value="0"
                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                      x:Name="AntiDeadzoneValueText"
                        Text="%0"
                       Foreground="#888888"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

                        </Grid>


                        <!-- HASSASİYET -->
                        <Grid Margin="0,6,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="42"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock x:Name="SensitivityLabel"
                                       Text="Hassasiyet"
                                       Foreground="#BDBDBD"
                                       VerticalAlignment="Center"/>

                            <Slider Grid.Column="1"
                    x:Name="SensitivitySlider"
                    Minimum="0"
                    Maximum="200"
                    Value="100"
                    VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="2"
                       x:Name="SensitivityValueText"
                        Text="%100"
                       Foreground="#888888"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

                        </Grid>

                    </StackPanel>

                </Border>

            </Grid>

        </Grid>

        </ScrollViewer>


        <!-- ====================================================== -->
        <!-- SABİT ALT BAR -->
        <!-- ====================================================== -->

        <Border Grid.Row="1"
                Background="#121212"
                BorderBrush="#303030"
                BorderThickness="0,1,0,0">

            <Grid Margin="12,0">


                <!-- SOL -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <Button x:Name="ResetDefaultsBtn"
                            Content="Varsayılanlara Dön"
                            Style="{StaticResource BottomButtonStyle}"
                            Margin="0"
                            Click="ResetToDefaultsBtn_Click"/>

                </StackPanel>


                <!-- SAĞ -->

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <Button x:Name="SaveBtn"
                            Content="Kaydet"
                            Style="{StaticResource BottomButtonStyle}"
                            Margin="0,0,8,0"
                            IsEnabled="False"
                            Click="SaveBtn_Click"/>

                    <Button x:Name="CancelBtn"
                            Content="İptal"
                            Style="{StaticResource BottomButtonStyle}"
                            Click="CancelBtn_Click"/>

                </StackPanel>

            </Grid>

        </Border>

    </Grid>

</UserControl>
