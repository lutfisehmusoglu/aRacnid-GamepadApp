<Window x:Class="GamepadApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:GamepadApp.Views"
        Title="aRacnid GamepadApp"
        Width="1100"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Icon="/assets/appicon.ico"
        WindowStartupLocation="CenterScreen"
        Background="#0D0D0D"
        Closing="MainWindow_Closing">

    <Window.Resources>

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">
            <Setter Property="Background"
                    Value="#161616"/>
            <Setter Property="Foreground"
                    Value="#A8A8A8"/>
            <Setter Property="BorderBrush"
                    Value="#2A2A2A"/>
            <Setter Property="BorderThickness"
                    Value="1"/>
            <Setter Property="FontSize"
                    Value="15"/>
            <Setter Property="Cursor"
                    Value="Hand"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Visibility"
                    Value="Collapsed"/>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ÜST NAVİGASYON -->
        <Grid Grid.Row="0"
              Margin="20,15,20,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="ProfileButton"
                    Grid.Column="0"
                    Width="48"
                    Height="48"
                    Content="🎮"
                    FontSize="22"
                    Background="#161616"
                    Foreground="White"
                    BorderBrush="#2A2A2A"
                    BorderThickness="1"
                    Click="ProfileButton_Click"/>

            <Button x:Name="GamepadNavButton"
                    Grid.Column="1"
                    Content="Gamepad"
                    Margin="8,0,4,0"
                    Style="{StaticResource NavigationButtonStyle}"
                    Background="#252525"
                    Foreground="White"
                    Click="GamepadTab_Click"/>

            <Button x:Name="ColorNavButton"
                    Grid.Column="2"
                    Content="Renk"
                    Margin="4,0"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="ColorTab_Click"/>

            <Button x:Name="ControlsNavButton"
                    Grid.Column="3"
                    Content="Kontroller"
                    Margin="4,0"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="ControlsTab_Click"/>

            <Button x:Name="AdvancedNavButton"
                    Grid.Column="4"
                    Content="Gelişmiş"
                    Margin="4,0,0,0"
                    Style="{StaticResource NavigationButtonStyle}"
                    Click="AdvancedTab_Click"/>

        </Grid>

        <!-- SAYFALAR -->
        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Margin="20,5,20,20"
                    Background="#0D0D0D"
                    BorderThickness="0">

            <!-- 1 - GAMEPAD -->
            <TabItem>
                <Grid Background="#0D0D0D"
                      Margin="10">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ÜST CİHAZ BİLGİLERİ -->
                    <Grid x:Name="DeviceInfoPanel"
                          Grid.Row="0"
                          Margin="0,0,0,20"
                          Opacity="0.45"
                          IsEnabled="False">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="#161616"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,10,0">

                            <StackPanel>
                                <TextBlock x:Name="GamepadLabelText"
                                           Text="Gamepad"
                                           Foreground="#8C8C8C"
                                           FontSize="13"/>

                                <TextBlock x:Name="ControllerStatusText"
                                           Text="Kol bağlı değil"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                        </Border>

                        <Border Grid.Column="1"
                                Background="#161616"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18"
                                Margin="0,0,10,0">

                            <StackPanel>
                                <TextBlock x:Name="ConnectionLabelText"
                                           Text="Bağlantı"
                                           Foreground="#8C8C8C"
                                           FontSize="13"/>

                                <TextBlock x:Name="ConnectionText"
                                           Text="—"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                        </Border>

                        <Border Grid.Column="2"
                                Background="#161616"
                                BorderBrush="#2A2A2A"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18">

                            <StackPanel>
                                <TextBlock x:Name="BatteryLabelText"
                                           Text="Pil"
                                           Foreground="#8C8C8C"
                                           FontSize="13"/>

                                <TextBlock x:Name="BatteryText"
                                           Text="—"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,6,0,0"/>
                            </StackPanel>

                        </Border>

                    </Grid>

                    <!-- SADE KOL GÖRSELİ -->
                    <Border Grid.Row="1"
                            Background="#0F0F0F"
                            BorderBrush="#252525"
                            BorderThickness="1"
                            CornerRadius="15">

                        <Grid>

                            <StackPanel x:Name="NoControllerPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">

                                <TextBlock Text="🎮"
                                           FontSize="64"
                                           HorizontalAlignment="Center"
                                           Opacity="0.30"/>

                                <TextBlock x:Name="NoControllerText"
                                           Text="Kol bağlı değil"
                                           Foreground="#777777"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,14,0,0"/>

                            </StackPanel>

                            <Image x:Name="ControllerImage"
                                   Source="/assets/controller.png"
                                   Width="620"
                                   Height="380"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"
                                   IsHitTestVisible="False"/>

                            <Button x:Name="LogitechWarningButton"
                                    Width="48"
                                    Height="48"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Margin="18"
                                    Background="#3A1717"
                                    Foreground="#FF6B6B"
                                    BorderBrush="#B64242"
                                    BorderThickness="1"
                                    FontSize="23"
                                    FontWeight="Bold"
                                    Content="⚠"
                                    Cursor="Hand"
                                    Visibility="Collapsed"
                                    Click="LogitechWarningButton_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="WarningBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="24">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="WarningBorder"
                                                        Property="Background"
                                                        Value="#512020"/>
                                                <Setter TargetName="WarningBorder"
                                                        Property="BorderBrush"
                                                        Value="#E05A5A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </Grid>

                    </Border>

                </Grid>
            </TabItem>

            <!-- 2 - RENK -->
            <TabItem>
                <Grid Background="#0D0D0D">

                    <Grid Margin="55,18,55,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Başlık -->
                        <StackPanel Grid.Row="0">
                            <TextBlock x:Name="ColorTitleText"
               Text="Lightbar Rengi"
               Foreground="White"
               FontSize="26"
               FontWeight="SemiBold"/>

                            <TextBlock x:Name="ColorSubtitleText"
               Text="Gamepad üzerindeki ışık çubuğunun rengini özelleştir."
               Foreground="#8F8F8F"
               FontSize="14"
               Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Ana içerik -->
                        <Grid Grid.Row="2">

                            <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="10"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Sol: Renk Seçici -->
                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <Grid Margin="30,20">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="10"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="ColorPickerTitleText"
                                               Grid.Row="0"
                                               Text="Renk Seçici"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <!-- + ile düzenleme modu açılana kadar pasif -->
                                    <Grid x:Name="ColorPickerGrid"
                                          Grid.Row="2"
                                          Width="350"
                                          Height="195"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ClipToBounds="True"
                                          MouseLeftButtonDown="ColorPickerGrid_MouseLeftButtonDown"
                                          MouseMove="ColorPickerGrid_MouseMove"
                                          MouseLeftButtonUp="ColorPickerGrid_MouseLeftButtonUp"
                                          MouseLeave="ColorPickerGrid_MouseLeave">      

                                        <!-- Üst yatay renk skalası:
                                             sol üst beyaz, sağa doğru renkler -->
                                        <Border CornerRadius="10"
                                                ClipToBounds="True">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.5"
                                                                     EndPoint="1,0.5">
                                                    <GradientStop Color="#FFFFFF" Offset="0"/>
                                                    <GradientStop Color="#FF0000" Offset="0.15"/>
                                                    <GradientStop Color="#FFFF00" Offset="0.32"/>
                                                    <GradientStop Color="#00FF00" Offset="0.49"/>
                                                    <GradientStop Color="#00FFFF" Offset="0.66"/>
                                                    <GradientStop Color="#0000FF" Offset="0.83"/>
                                                    <GradientStop Color="#FF00FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>

                                            <!-- Aşağı doğru siyaha karart -->
                                            <Rectangle>
                                                <Rectangle.Fill>
                                                    <LinearGradientBrush StartPoint="0.5,0"
                                                                         EndPoint="0.5,1">
                                                        <GradientStop Color="#00000000" Offset="0"/>
                                                        <GradientStop Color="#FF000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Rectangle.Fill>
                                            </Rectangle>
                                        </Border>

                                        <!-- Seçim göstergesi -->
                                        <Ellipse x:Name="ColorPickerMarker"
                                                 Width="14"
                                                 Height="14"
                                                 Stroke="White"
                                                 StrokeThickness="2"
                                                 Fill="#33000000"
                                                 HorizontalAlignment="Left"
                                                 VerticalAlignment="Top"
                                                 Margin="106,83,0,0"
                                                 IsHitTestVisible="False"/>
                                    </Grid>

                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Border x:Name="SelectedColorSwatch"
                                                    Width="26"
                                                    Height="26"
                                                    Background="#4A90E2"
                                                    CornerRadius="6"
                                                    Margin="0,0,10,0"/>

                                            <TextBlock x:Name="SelectedColorLabel"
                                                       Text="Seçili Renk"
                                                       Foreground="#BDBDBD"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <TextBlock x:Name="PreviewHexText"
                                                   Grid.Column="1"
                                                   Text="#4A90E2"
                                                   Foreground="#BDBDBD"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                </Grid>
                            </Border>

                            <!-- Sağ: Ayarlar -->
                            <Border Grid.Row="0"
                                    Grid.Column="2"
                                    Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                <Grid x:Name="ColorSettingsGrid"
                                      Margin="30,20"
                                      IsHitTestVisible="False"
                                      Opacity="0.45">

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="18"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="16"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock x:Name="ColorSettingsTitleText"
                                               Grid.Row="0"
                                               Text="Renk Ayarları"
                                               Foreground="White"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <!-- Kırmızı -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="RedLabel"
                                                   Text="Kırmızı"
                                                   Foreground="#D0D0D0"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Slider x:Name="RedSlider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="255"
                                                Value="74"
                                                ValueChanged="ColorSlider_ValueChanged"
                                                VerticalAlignment="Center"
                                                Margin="10,0"/>

                                        <TextBlock x:Name="RedValueText"
                                                   Grid.Column="2"
                                                   Text="74"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Yeşil -->
                                    <Grid Grid.Row="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="GreenLabel"
                                                   Text="Yeşil"
                                                   Foreground="#D0D0D0"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Slider x:Name="GreenSlider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="255"
                                                Value="144"
                                                ValueChanged="ColorSlider_ValueChanged"
                                                VerticalAlignment="Center"
                                                Margin="10,0"/>

                                        <TextBlock x:Name="GreenValueText"
                                                   Grid.Column="2"
                                                   Text="144"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Mavi -->
                                    <Grid Grid.Row="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="45"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="BlueLabel"
                                                   Text="Mavi"
                                                   Foreground="#D0D0D0"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Slider x:Name="BlueSlider"
                                                Grid.Column="1"
                                                Minimum="0"
                                                Maximum="255"
                                                Value="226"
                                                ValueChanged="ColorSlider_ValueChanged"
                                                VerticalAlignment="Center"
                                                Margin="10,0"/>

                                        <TextBlock x:Name="BlueValueText"
                                                   Grid.Column="2"
                                                   Text="226"
                                                   Foreground="White"
                                                   FontSize="14"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- HEX -->
                                    <Grid Grid.Row="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock x:Name="HexLabel"
                                                   Text="HEX"
                                                   Foreground="#D0D0D0"
                                                   FontSize="14"
                                                   VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Height="38"
                                                Background="#0D0D0D"
                                                BorderBrush="#303030"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Margin="10,0,0,0">

                                            <TextBox x:Name="HexValueText"
                                                     Text="#4A90E2"
                                                     Foreground="White"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     FontSize="14"
                                                     VerticalContentAlignment="Center"
                                                     Margin="8,0"
                                                     MaxLength="7"
                                                     KeyDown="HexValueText_KeyDown"
                                                     LostFocus="HexValueText_LostFocus"/>
                                        </Border>
                                    </Grid>

                                </Grid>
                            </Border>

                            <!-- Kullanıcının renk slotları -->
                            <StackPanel Grid.Row="2"
                                        Grid.Column="0"
                                        Grid.ColumnSpan="3">

                                <TextBlock x:Name="ColorSlotsLabel"
                                           Text="Renkler"
                                           Foreground="White"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,12"/>

                                <!-- Başlangıçta: Kırmızı, Mavi, Yeşil, Sarı, + -->
                                <StackPanel x:Name="ColorSlotsPanel"
                                            Orientation="Horizontal"/>
                            </StackPanel>

                            <!-- Açıklama -->
                            <TextBlock x:Name="ColorEditHintText"
                                       Grid.Row="4"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Text="Renk eklemek veya mevcut renkleri düzenlemek için + ile belirtilen butona tıklayın."
                                       Foreground="#7F7F7F"
                                       FontSize="12"/>

                            <!-- Lightbar Aç / Kapat -->
                            <Grid Grid.Row="6"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="LightbarTitleText"
                                               Text="Lightbar"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="LightbarDescText"
                                               Text="Gamepad ışığını aç veya kapat."
                                               Foreground="#8F8F8F"
                                               FontSize="13"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                                <Button x:Name="LightbarToggleButton"
                                        Grid.Column="1"
                                        Width="76"
                                        Height="34"
                                        Content="AÇIK"
                                        Foreground="White"
                                        Background="#2A2A2A"
                                        BorderBrush="#3A3A3A"
                                        BorderThickness="1"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="LightbarToggleButton_Click"/>
                            </Grid>

                        </Grid>

                    </Grid>

                </Grid>
            </TabItem>

            <!-- 3 - KONTROLLER -->
            <TabItem>
                <Grid Background="#0D0D0D">
                    <!-- Oluşturduğumuz Main View'u buraya çağırıyoruz -->
                    <views:ControlsMainView x:Name="ControlsPage"/>
                </Grid>
            </TabItem>

            <!-- 4 - GELİŞMİŞ -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Background="#0D0D0D">

                    <Grid Margin="55,18,55,25">

                        <StackPanel>

                            <!-- Başlık -->
                            <TextBlock x:Name="AdvancedTitleText"
                                       Text="Gelişmiş Ayarlar"
                                       Foreground="White"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,4"/>

                            <TextBlock x:Name="AdvancedSubtitleText"
                                       Text="Uygulama davranışı ve sistem bileşenleri."
                                       Foreground="#8F8F8F"
                                       FontSize="14"
                                       Margin="0,0,0,30"/>

                            <!-- === AYARLAR === -->
                            <TextBlock x:Name="GeneralSectionLabel"
                                       Text="Genel"
                                       Foreground="#A0A0A0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,10"/>

                            <!-- Başlangıçta Çalıştır -->
                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="StartupTitleText"
                                                   Text="Windows ile başlat"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="StartupDescText"
                                                   Text="Windows başladığında uygulama otomatik olarak Ana Profil ile açılır."
                                                   Foreground="#8F8F8F"
                                                   FontSize="13"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="StartupToggleButton"
                                            Grid.Column="1"
                                            Width="76"
                                            Height="34"
                                            Content="KAPALI"
                                            Foreground="White"
                                            Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="StartupToggleButton_Click"/>
                                </Grid>

                            </Border>

                            <!-- Sistem Tepsisi -->
                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="TrayTitleText"
                                                   Text="Sistem tepsisine küçült"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="TrayDescText"
                                                   Text="Kapatma düğmesine basıldığında uygulama kapanmaz, sistem tepsisine küçültülür."
                                                   Foreground="#8F8F8F"
                                                   FontSize="13"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="TrayToggleButton"
                                            Grid.Column="1"
                                            Width="76"
                                            Height="34"
                                            Content="KAPALI"
                                            Foreground="White"
                                            Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="TrayToggleButton_Click"/>
                                </Grid>

                            </Border>

                            <!-- Bağlantı Bildirimleri -->
                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="NotificationsTitleText"
                                                   Text="Bağlantı bildirimleri"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="NotificationsDescText"
                                                   Text="Gamepad bağlandığında veya bağlantısı kesildiğinde bildirim gösterilir."
                                                   Foreground="#8F8F8F"
                                                   FontSize="13"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="NotificationsToggleButton"
                                            Grid.Column="1"
                                            Width="76"
                                            Height="34"
                                            Content="AÇIK"
                                            Foreground="White"
                                            Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Click="NotificationsToggleButton_Click"/>
                                </Grid>

                            </Border>

                            <!-- Dil -->
                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="LanguageTitleText"
                                                   Text="Dil / Language"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="LanguageDescText"
                                                   Text="Uygulama arayüz dilini değiştir."
                                                   Foreground="#8F8F8F"
                                                   FontSize="13"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">

                                        <Button x:Name="TurkishLangButton"
                                                Width="42"
                                                Height="34"
                                                Content="TR"
                                                Foreground="White"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Click="TurkishLangButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="#252525"
                                                            BorderBrush="#3A3A3A"
                                                            BorderThickness="1"
                                                            CornerRadius="8,0,0,8">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                        <Button x:Name="EnglishLangButton"
                                                Width="42"
                                                Height="34"
                                                Content="EN"
                                                Foreground="#A0A0A0"
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Cursor="Hand"
                                                Click="EnglishLangButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border"
                                                            Background="#151515"
                                                            BorderBrush="#3A3A3A"
                                                            BorderThickness="1"
                                                            CornerRadius="0,8,8,0">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </StackPanel>
                                </Grid>

                            </Border>

                            <!-- === GÜNCELLEMELER === -->
                            <Grid Margin="0,16,0,10">
                                <TextBlock x:Name="UpdatesSectionLabel"
                                           Text="Güncellemeler"
                                           Foreground="#A0A0A0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="CheckUpdatesButton"
                                        Content="Güncellemeleri Kontrol Et"
                                        HorizontalAlignment="Right"
                                        Height="30"
                                        Padding="12,0"
                                        Foreground="#D0D0D0"
                                        Background="#1B1B1B"
                                        BorderBrush="#343434"
                                        BorderThickness="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="CheckUpdatesButton_Click"/>
                            </Grid>

                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18"
                                    Margin="0,0,0,10">

                                <StackPanel>
                                    <TextBlock x:Name="UpdatesTitleText"
                                               Text="Mevcut sürüm"
                                               Foreground="White"
                                               FontSize="15"
                                               FontWeight="SemiBold"/>

                                    <TextBlock x:Name="CurrentVersionText"
                                               Text="—"
                                               Foreground="#8F8F8F"
                                               FontSize="13"
                                               Margin="0,4,0,0"/>
                                </StackPanel>

                            </Border>

                            <!-- === SİSTEM BİLEŞENLERİ === -->
                            <Grid Margin="0,16,0,10">
                                <TextBlock x:Name="ComponentsSectionLabel"
                                           Text="Sistem Bileşenleri"
                                           Foreground="#A0A0A0"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="ManageComponentsButton"
                                        Content="Bileşenleri Yönet"
                                        HorizontalAlignment="Right"
                                        Height="30"
                                        Padding="12,0"
                                        Foreground="#D0D0D0"
                                        Background="#1B1B1B"
                                        BorderBrush="#343434"
                                        BorderThickness="1"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Click="ManageComponentsButton_Click"/>
                            </Grid>

                            <!-- ViGEmBus -->
                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ViGEmBus"
                                                       Foreground="White"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>

                                            <Border x:Name="ViGEmStatusBadge"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="10,0,0,0"
                                                    Background="#1A3A1A">
                                                <TextBlock x:Name="ViGEmStatusText"
                                                           Text="Denetleniyor..."
                                                           Foreground="#6F6F6F"
                                                           FontSize="11"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="ViGEmDescText"
                                                   Text="Sanal gamepad emülasyonu için gerekli sürücü."
                                                   Foreground="#8F8F8F"
                                                   FontSize="13"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="ViGEmActionButton"
                                            Grid.Column="1"
                                            Content="Yükle"
                                            Foreground="White"
                                            Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Padding="14,0"
                                            Visibility="Collapsed"
                                            Click="ViGEmActionButton_Click"/>
                                </Grid>

                            </Border>

                            <!-- HidHide -->
                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18"
                                    Margin="0,0,0,10">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="HidHide"
                                                       Foreground="White"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"/>

                                            <Border x:Name="HidHideStatusBadge"
                                                    CornerRadius="4"
                                                    Padding="8,3"
                                                    Margin="10,0,0,0"
                                                    Background="#1A3A1A">
                                                <TextBlock x:Name="HidHideStatusText"
                                                           Text="Denetleniyor..."
                                                           Foreground="#6F6F6F"
                                                           FontSize="11"/>
                                            </Border>
                                        </StackPanel>

                                        <TextBlock x:Name="HidHideDescText"
                                                   Text="Çift input sorununu önler. Fiziksel gamepad'i sistemden gizler."
                                                   Foreground="#8F8F8F"
                                                   FontSize="13"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="HidHideActionButton"
                                            Grid.Column="1"
                                            Content="Yükle"
                                            Foreground="White"
                                            Background="#2A2A2A"
                                            BorderBrush="#3A3A3A"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Padding="14,0"
                                            Visibility="Collapsed"
                                            Click="HidHideActionButton_Click"/>
                                </Grid>

                            </Border>

                            <!-- === SIFIRLA === -->
                            <TextBlock x:Name="ResetSectionLabel"
                                       Text="Sıfırlama"
                                       Foreground="#A0A0A0"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Margin="0,16,0,10"/>

                            <Border Background="#151515"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="22,18">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock x:Name="ResetTitleText"
                                                   Text="Ayarları sıfırla"
                                                   Foreground="White"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"/>

                                        <TextBlock x:Name="ResetDescText"
                                                   Text="Tüm genel uygulama ayarlarını varsayılan değerlere döndür. Profil ayarları etkilenmez."
                                                   Foreground="#8F8F8F"
                                                   FontSize="13"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <Button x:Name="ResetSettingsButton"
                                            Grid.Column="1"
                                            Content="Sıfırla"
                                            Foreground="#FF6B6B"
                                            Background="Transparent"
                                            BorderBrush="#4A2A2A"
                                            BorderThickness="1"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Cursor="Hand"
                                            Padding="14,0"
                                            Height="34"
                                            Click="ResetSettingsButton_Click"/>
                                </Grid>

                            </Border>

                        </StackPanel>

                    </Grid>

                </ScrollViewer>
            </TabItem>

        </TabControl>

    </Grid>

</Window>
