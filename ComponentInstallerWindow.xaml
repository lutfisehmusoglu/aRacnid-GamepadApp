<Window x:Class="GamepadApp.ComponentInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerekli Bileşenler"
        Width="620"
        Height="540"
        MinWidth="620"
        MinHeight="540"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D0D"
        Closing="Window_Closing"
        Closed="Window_Closed">

    <Window.Resources>
        <Style x:Key="ComponentActionButtonStyle"
               TargetType="Button">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="Gerekli Bileşenler"
                   Foreground="White"
                   FontSize="24"
                   FontWeight="SemiBold"/>

        <TextBlock x:Name="SubtitleText"
                   Grid.Row="1"
                   Text="Sanal gamepad özellikleri için gereken bileşenleri buradan kurabilirsiniz."
                   Foreground="#9A9A9A"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Margin="0,6,0,18"/>

        <Border Grid.Row="2"
                Background="#151515"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,17"
                Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ViGEmBus"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="ViGEmRequirementText"
                                   Text="Gerekli"
                                   Foreground="#D7A84A"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="9,3,0,0"/>
                        <Border x:Name="ViGEmStatusBadge"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="10,0,0,0"
                                Background="#3A1A1A">
                            <TextBlock x:Name="ViGEmStatusText"
                                       Text="Kurulu değil"
                                       Foreground="#F44336"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ViGEmDescriptionText"
                               Text="Sanal Xbox 360 ve DualShock 4 controller oluşturur."
                               Foreground="#8F8F8F"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,5,20,0"/>
                </StackPanel>

                <Button x:Name="ViGEmActionButton"
                        Grid.Column="1"
                        Content="Yükle"
                        Style="{StaticResource ComponentActionButtonStyle}"
                        Click="ViGEmActionButton_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Background="#151515"
                BorderBrush="#2A2A2A"
                BorderThickness="1"
                CornerRadius="10"
                Padding="20,17">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HidHide"
                                   Foreground="White"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="HidHideRequirementText"
                                   Text="Önerilen"
                                   Foreground="#6AA9E9"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="9,3,0,0"/>
                        <Border x:Name="HidHideStatusBadge"
                                CornerRadius="4"
                                Padding="8,3"
                                Margin="10,0,0,0"
                                Background="#3A1A1A">
                            <TextBlock x:Name="HidHideStatusText"
                                       Text="Kurulu değil"
                                       Foreground="#F44336"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="HidHideDescriptionText"
                               Text="Çift input sorununu önler ve fiziksel controller'ı gizler."
                               Foreground="#8F8F8F"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Margin="0,5,20,0"/>
                </StackPanel>

                <Button x:Name="HidHideActionButton"
                        Grid.Column="1"
                        Content="Yükle"
                        Style="{StaticResource ComponentActionButtonStyle}"
                        Click="HidHideActionButton_Click"/>
            </Grid>
        </Border>

        <StackPanel x:Name="ProgressPanel"
                    Grid.Row="4"
                    VerticalAlignment="Top"
                    Visibility="Collapsed"
                    Margin="0,18,0,0">
            <TextBlock x:Name="ProgressText"
                       Text="İndiriliyor..."
                       Foreground="#D0D0D0"
                       FontSize="12"
                       Margin="0,0,0,7"/>
            <ProgressBar x:Name="InstallProgressBar"
                         Height="6"
                         Minimum="0"
                         Maximum="100"
                         Foreground="#4A90E2"
                         Background="#242424"/>
        </StackPanel>

        <Grid Grid.Row="5" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SecurityNoteText"
                       Grid.Column="0"
                       Text="Paketler resmî kaynaktan indirilir ve çalıştırılmadan önce doğrulanır."
                       Foreground="#737373"
                       FontSize="11"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,18,0"/>

            <Button x:Name="CloseButton"
                    Grid.Column="1"
                    Content="Kapat"
                    Style="{StaticResource ComponentActionButtonStyle}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>
